         - Goal: ${action.docGoal}
         - Feedback: ${action.docFeedback}
         - Result: ${action.docResult}
        """
#end
        self.${action.name}_client = ActionClient(self, ${helperPy.capitalize(${action.name})}, '${action.name}')
#end
#foreach($action in ${rosParam.actionServers})
        self._action_cb_group_${action.name} = ReentrantCallbackGroup()
#if( ${action.isDocExist()} )
        """
        ${action.docDescription}
         - Goal: ${action.docGoal}
         - Feedback: ${action.docFeedback}
         - Result: ${action.docResult}
        """
#end
        self.${action.name}_server = ActionServer(self, ${helperPy.capitalize(${action.name})}, '${action.name}', execute_callback=self.execute_${action.name}, goal_callback=self.handle_goal_${action.name}, cancel_callback=self.handle_cancel_${action.name}, callback_group=self._action_cb_group_${action.name})
#end
#foreach($timer in ${rosParam.timers})
