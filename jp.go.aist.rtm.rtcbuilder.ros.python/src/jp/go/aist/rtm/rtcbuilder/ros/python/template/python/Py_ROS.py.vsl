    def _declare_parameters(self):
#foreach($param in ${rosParam.parameters})
#if( ${param.isDocExist()} )
        """
        ${param.docDescription}
         - Name: ${param.docDataname}
         - DefaultValue: ${param.docDefault}
         - Unit: ${param.docUnit}
         - Range: ${param.docRange}
         - Constraint: ${param.docConstraint}
        """
#end
        desc_${param.name} = ParameterDescriptor(description='${param.docDescription}'#if(${param.readOnly}), read_only=True#end)
        self.declare_parameter('${param.name}', ${helperPy.convDefault(${param})}, desc_${param.name})
#end
        self.add_on_set_parameters_callback(self._on_set_parameters)

    def _on_set_parameters(self, params):
        for param in params:
#foreach($param in ${rosParam.parameters})
            if param.name == '${param.name}':
                ${sharp} TODO: Update internal state when this parameter changes.
                ${sharp} Note: min / max / step are documentation metadata only. Add explicit validation here if needed.
                value = param.value
                ${sharp} TODO: Store the parameter value in member variables or runtime settings as needed.
                _ = value
#end
        return SetParametersResult(successful=True, reason='')
#end

