    def ${action.name}_action_response(self, future):
        ${sharp} Action Client: ${action.name}
        ${sharp} Type: ${helperPy.convActionType(${action.type}, ${rosParam})}
        ${sharp} Description: ${action.docDescription}
        goal_handle = future.result()
        if not goal_handle.accepted:
            self.get_logger().error('Goal rejected')
            return
        result_future = goal_handle.get_result_async()
        result_future.add_done_callback(self.${action.name}_action_result)

    def ${action.name}_action_feedback(self, feedback_msg):
