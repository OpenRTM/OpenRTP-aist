        ${sharp} Period: ${timer.rate} sec
        ${sharp} Callback: ${timer.callBack}()
        ${sharp} Description: ${timer.description}
        self._${timer.name} = self.create_timer(${timer.rate}, self.${timer.callBack})
        self._${timer.name}.cancel()
#end
        return TransitionCallbackReturn.SUCCESS

