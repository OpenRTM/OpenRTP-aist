#end
        ${sharp} Publish Topic: ${topic.name}
        ${sharp} Type: ${helperPy.convTopicType(${topic.messageType}, ${rosParam})}
        ${sharp} Description: ${topic.docDescription}
        self.${topic.name}_publisher = self.create_lifecycle_publisher(${helperPy.getTypeName(${topic.messageType})}, '${topic.name}', QoSProfile(depth=${topic.depth}, reliability=QoSReliabilityPolicy.${helperPy.getReliableType(${topic.reliabilityType})}, history=QoSHistoryPolicy.${helperPy.getHistoryType(${topic.historyType})}))
#end
#foreach($topic in ${rosParam.topicSubscribes})
#if( ${topic.isDocExist()} )
