        ${topic.docDescription}
	     - Type: ${topic.docType}
         - Semantics: ${topic.docSemantics}
	     - Unit: ${topic.docUnit}
         - Operation Cycle: ${topic.docOccurrence}
        """
#end
        self.${topic.name}_sub = self.create_subscription(${helperPy.getTypeName(${topic.messageType})}, '${topic.name}', self.${topic.name}_callback, QoSProfile(depth=${topic.depth}, reliability=QoSReliabilityPolicy.${helperPy.getReliableType(${topic.reliabilityType})}, history=QoSHistoryPolicy.${helperPy.getHistoryType(${topic.historyType})}))
#end
#foreach($service in ${rosParam.serviceClients})
