<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eval5_operator_py_pkg</name>
  <version>0.0.1</version>
  <description>Python operator-side all-in-one sample node that uses the robot interface package.</description>
  <maintainer email="todo@example.com">rsdlab</maintainer>
  <license>LGPL-3.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <!-- Core dependencies -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <!-- Parameter / descriptor dependencies -->
  <exec_depend>rcl_interfaces</exec_depend>

  <!-- Topic message dependencies -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>eval5_robot_py_pkg_interfaces</exec_depend>

  <!-- Action dependencies -->
  <exec_depend>action_msgs</exec_depend>


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
