${sharp}include <memory>
${sharp}include "rclcpp/rclcpp.hpp"
${sharp}include "${rosParam.packageName}/${rosParam.nodeName}.hpp"

int main(int argc, char ** argv)
{
  rclcpp::init(argc, argv);
  auto node = std::make_shared<${rosParam.packageName}::${rosParam.className}>();
  rclcpp::spin(node->get_node_base_interface());
  rclcpp::shutdown();
  return 0;
}
