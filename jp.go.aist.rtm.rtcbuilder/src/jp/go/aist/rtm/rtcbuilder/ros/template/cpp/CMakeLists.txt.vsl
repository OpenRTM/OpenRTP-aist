cmake_minimum_required(VERSION 3.8)
project(${rosParam.packageName})

if(CMAKE_COMPILER_IS_GNUCXX OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
  add_compile_options(-Wall -Wextra -Wpedantic)
endif()

find_package(ament_cmake REQUIRED)
${sharp} Core dependencies
find_package(lifecycle_msgs REQUIRED)
find_package(rclcpp REQUIRED)
find_package(rclcpp_lifecycle REQUIRED)
#if( ${rosParam.parameters.size()}>0 )
# Parameter / descriptor dependencies
find_package(rcl_interfaces REQUIRED)
#end
#if( ${tmpltHelper.getTopicTypes(${rosParam}).size()} > 0 )
${sharp} Topic message dependencies
#foreach($topic in ${tmpltHelper.getTopicTypes(${rosParam})})
find_package(${tmpltHelper.getMessageBasename(${topic})} REQUIRED)
#end
#end
#if( ${tmpltHelper.getServiceTypes(${rosParam}).size()} > 0 )
${sharp} Service dependencies
#if( ${tmpltHelper.getServicePackage(${rosParam}).size()}>0 )
#foreach($type in ${tmpltHelper.getServicePackage(${rosParam})})
find_package(${type} REQUIRED)
#end
#end
#end
#if( ${rosParam.actionClients.size()}>0 || ${rosParam.actionServers.size()}>0 )
${sharp} Action dependencies
find_package(action_msgs REQUIRED)
#if( ${tmpltHelper.getActionPackage(${rosParam}).size()}>0 )
#foreach($type in ${tmpltHelper.getActionPackage(${rosParam})})
find_package($type REQUIRED)
#end
#end
find_package(rclcpp_action REQUIRED)
#end
#if( ${rosParam.targetEnv.getLibraries().size()}>0 )
${sharp} Extra dependencies
#foreach($ext in ${rosParam.targetEnv.getLibraries()})
find_package(${ext.name} REQUIRED)
#end
#end
add_library(${dol}{PROJECT_NAME}_lib src/${rosParam.nodeName}.cpp)
target_include_directories(${dol}{PROJECT_NAME}_lib PUBLIC
  ${dol}<BUILD_INTERFACE:${dol}{CMAKE_CURRENT_SOURCE_DIR}/include>
  ${dol}<INSTALL_INTERFACE:include>
)
ament_target_dependencies(${dol}{PROJECT_NAME}_lib
  lifecycle_msgs
  rclcpp
  rclcpp_lifecycle
#if( ${rosParam.parameters.size()}>0 )
  rcl_interfaces
#end
#foreach($type in ${tmpltHelper.getIfTypes(${rosParam})})
  $type
#end
#if( ${rosParam.actionClients.size()}>0 || ${rosParam.actionServers.size()}>0 )
  action_msgs
  rclcpp_action
#end
#foreach($ext in ${rosParam.targetEnv.getLibraries()})
  ${ext.name}
#end
)

add_executable(${rosParam.nodeName} src/main.cpp)
target_link_libraries(${rosParam.nodeName} ${dol}{PROJECT_NAME}_lib)

install(TARGETS ${dol}{PROJECT_NAME}_lib ${rosParam.nodeName}
  ARCHIVE DESTINATION lib
  LIBRARY DESTINATION lib
  RUNTIME DESTINATION lib/${dol}{PROJECT_NAME}
)
install(DIRECTORY include/ DESTINATION include)
install(DIRECTORY launch/ DESTINATION share/${dol}{PROJECT_NAME}/launch)
install(DIRECTORY config/ DESTINATION share/${dol}{PROJECT_NAME}/config)

install(FILES LICENSE README.md DESTINATION share/${dol}{PROJECT_NAME})

${sharp} Optional local Debian package generation with CPack.
${sharp} This block is commented out so normal colcon builds are not affected.
${sharp} For ROS 2 release workflows, prefer bloom.
${sharp} To try local .deb generation, uncomment this block after checking package metadata,
${sharp} then run cpack -G DEB from the CMake build directory.
${sharp}
${sharp} string(REPLACE "_" "-" DEBIAN_PROJECT_NAME "${dol}{PROJECT_NAME}")
${sharp} set(CPACK_GENERATOR "DEB")
${sharp} set(CPACK_PACKAGE_NAME "ros-${dol}ENV{ROS_DISTRO}-${dol}{DEBIAN_PROJECT_NAME}")
${sharp} set(CPACK_PACKAGE_VERSION "${rosParam.version}")
${sharp} set(CPACK_PACKAGE_CONTACT "${rosParam.contactAddress}")
${sharp} set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${rosParam.maintainer}")
${sharp} set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
${sharp} set(CPACK_DEBIAN_PACKAGE_SECTION "devel")
${sharp} set(CPACK_DEBIAN_PACKAGE_PRIORITY "optional")
${sharp} set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
${sharp} include(CPack)

ament_package()
