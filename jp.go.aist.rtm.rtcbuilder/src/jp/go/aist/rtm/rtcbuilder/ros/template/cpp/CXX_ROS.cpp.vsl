}

void ${rosParam.className}::${action.name}_action_response(rclcpp_action::ClientGoalHandle<${tmpltHelper.capitalize(${action.name})}>::SharedPtr goal_handle)
{
  // Action Client: ${action.name}
  // Type: ${tmpltHelper.convActionType(${action.type}, ${rosParam})}
  // Description: ${action.docDescription}
  if (!goal_handle) {
    RCLCPP_ERROR(this->get_logger(), "Goal rejected");
    return;
  }
  RCLCPP_INFO(this->get_logger(), "Goal accepted");
}

void ${rosParam.className}::${action.name}_action_feedback(rclcpp_action::ClientGoalHandle<${tmpltHelper.capitalize(${action.name})}>::SharedPtr, const std::shared_ptr<const ${tmpltHelper.capitalize(${action.name})}::Feedback> feedback)
{
  // Action Client: ${action.name}
  // Type: ${tmpltHelper.convActionType(${action.type}, ${rosParam})}
  // Description: ${action.docDescription}
  // TODO: Use feedback data as needed.
  (void)feedback;
}

void ${rosParam.className}::${action.name}_action_result(const rclcpp_action::ClientGoalHandle<${tmpltHelper.capitalize(${action.name})}>::WrappedResult & result)
{
  // Action Client: ${action.name}
  // Type: ${tmpltHelper.convActionType(${action.type}, ${rosParam})}
  // Description: ${action.docDescription}
  // TODO: Use result data as needed.
  (void)result;
}

#end
#foreach($action in ${rosParam.actionServers})
rclcpp_action::GoalResponse ${rosParam.className}::handle_goal_${action.name}(const rclcpp_action::GoalUUID & uuid, std::shared_ptr<const ${tmpltHelper.capitalize(${action.name})}::Goal> goal)
{
  // Action Server: ${action.name}
  // Type: ${tmpltHelper.convActionType(${action.type}, ${rosParam})}
  // Description: ${action.docDescription}
  (void)uuid;
  (void)goal;
  return rclcpp_action::GoalResponse::ACCEPT_AND_EXECUTE;
}

rclcpp_action::CancelResponse ${rosParam.className}::handle_cancel_${action.name}(const std::shared_ptr<GoalHandle${tmpltHelper.capitalize(${action.name})}> goal_handle)
{
  // Action Server: ${action.name}
  // Type: ${tmpltHelper.convActionType(${action.type}, ${rosParam})}
  // Description: ${action.docDescription}
  (void)goal_handle;
  return rclcpp_action::CancelResponse::ACCEPT;
}

void ${rosParam.className}::handle_accepted_${action.name}(const std::shared_ptr<GoalHandle${tmpltHelper.capitalize(${action.name})}> goal_handle)
{
  // Action Server: ${action.name}
  // Type: ${tmpltHelper.convActionType(${action.type}, ${rosParam})}
  // Description: ${action.docDescription}
  std::thread{std::bind(&${rosParam.className}::execute_${action.name}, this, std::placeholders::_1), goal_handle}.detach();
}

void ${rosParam.className}::execute_${action.name}(const std::shared_ptr<GoalHandle${tmpltHelper.capitalize(${action.name})}> goal_handle)
{
  // Action Server: ${action.name}
  // Type: ${tmpltHelper.convActionType(${action.type}, ${rosParam})}
  // Description: ${action.docDescription}
  const auto goal = goal_handle->get_goal();
  auto result = std::make_shared<${tmpltHelper.capitalize(${action.name})}::Result>();

  // TODO: Read the goal and implement the action execution logic.
  // TODO: Set feedback and result fields as needed.
  (void)goal;

  goal_handle->succeed(result);
}

