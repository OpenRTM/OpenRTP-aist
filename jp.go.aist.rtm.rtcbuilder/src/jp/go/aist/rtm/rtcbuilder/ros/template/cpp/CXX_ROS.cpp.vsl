void ${rosParam.className}::handle_${service.name}(const std::shared_ptr<${tmpltHelper.slash2Cc(${tmpltHelper.convServiceType(${service.type}, ${rosParam})})}::Request> request, std::shared_ptr<${tmpltHelper.slash2Cc(${tmpltHelper.convServiceType(${service.type}, ${rosParam})})}::Response> response)
{
