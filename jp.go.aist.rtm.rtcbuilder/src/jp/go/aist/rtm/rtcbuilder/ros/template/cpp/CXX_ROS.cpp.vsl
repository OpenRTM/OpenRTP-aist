using CallbackReturn = rclcpp_lifecycle::node_interfaces::LifecycleNodeInterface::CallbackReturn;

namespace ${rosParam.packageName}
{

${rosParam.className}::${rosParam.className}(const rclcpp::NodeOptions & options)
: rclcpp_lifecycle::LifecycleNode("${rosParam.nodeName}", options)
{
  RCLCPP_INFO(this->get_logger(), "[Constructor] Node created.");
#if( ${rosParam.parameters.size()}>0 )
  declare_parameters();
#end
}

#if( ${rosParam.parameters.size()}>0 )
// ============================================================
// Parameter handling
// ============================================================

void ${rosParam.className}::declare_parameters()
{
#foreach($param in ${rosParam.parameters})
#if( ${param.isDocExist()} )
  // ${param.docDescription}
  // - Name: ${param.docDataname}
  // - DefaultValue: ${param.docDefault}
  // - Unit: ${param.docUnit}
  // - Range: ${param.docRange}
  // - Constraint: ${param.docConstraint}
#end
  rcl_interfaces::msg::ParameterDescriptor desc_${param.name};
  desc_${param.name}.description = "${param.docDescription}";
#if( ${param.readOnly} )
  desc_${param.name}.read_only = true;
#end
  this->declare_parameter("${param.name}", ${tmpltHelper.quoteDefaultWithType(${param})}, desc_${param.name});
#end
  param_cb_handle_ = this->add_on_set_parameters_callback(std::bind(&${rosParam.className}::on_set_parameters, this, std::placeholders::_1));
}

rcl_interfaces::msg::SetParametersResult ${rosParam.className}::on_set_parameters(const std::vector<rclcpp::Parameter> & params)
{
  rcl_interfaces::msg::SetParametersResult result;
  result.successful = true;

  for (const auto & param : params) {
#foreach($param in ${rosParam.parameters})
    if (param.get_name() == "${param.name}") {
      // TODO: Update internal state when this parameter changes.
      // Note: min / max / step are documentation metadata only. Add explicit validation here if needed.
      const ${tmpltHelper.convType(${param.type})} value = param.as_${param.type}();
      (void)value;
      // TODO: Store the parameter value in member variables or runtime settings as needed.
    }
#end
  }

  return result;
}

#end
// ============================================================
// Lifecycle callbacks
// ============================================================

#if( ${rosParam.isCallbackDocExist(0)} )
/*!
 * ${rosParam.getDocActionOverView(0)}
 */
#end
CallbackReturn ${rosParam.className}::on_configure(const rclcpp_lifecycle::State &)
{
  RCLCPP_INFO(this->get_logger(), "[on_configure] called.");
  // TODO: Implement initialization required for this lifecycle transition.
#if( ${rosParam.topicPublishes.size()}>0 )
#foreach($topic in ${rosParam.topicPublishes})
  // Publish Topic: ${topic.name}
  // Type: ${tmpltHelper.convTopicType(${topic.messageType}, ${rosParam})}
  // Description: ${topic.docDescription}
  ${topic.varCallbackName}_ = this->create_publisher<${tmpltHelper.slash2Cc(${tmpltHelper.convTopicType(${topic.messageType}, ${rosParam})})}>("${topic.name}", rclcpp::QoS(${topic.depth}).${tmpltHelper.convReliabilityType(${topic.reliabilityType})}());
#end
#end
#if( ${rosParam.topicSubscribes.size()}>0 )
#foreach($topic in ${rosParam.topicSubscribes})
  ${topic.name}_sub_ = this->create_subscription<${tmpltHelper.slash2Cc(${topic.messageType})}>("${topic.name}", rclcpp::QoS(${topic.depth}).${tmpltHelper.convReliabilityType(${topic.reliabilityType})}(), std::bind(&${rosParam.className}::${topic.varCallbackName}, this, std::placeholders::_1));
#end
#end
#if( ${rosParam.serviceClients.size()}>0 )
#foreach($service in ${rosParam.serviceClients})
  ${service.varCallbackName}_ = this->create_client<${tmpltHelper.slash2Cc(${tmpltHelper.convServiceType(${service.type}, ${rosParam})})}>("${service.name}");
#end
#end
#if( ${rosParam.serviceServers.size()}>0 )
#foreach($service in ${rosParam.serviceServers})
  ${service.name}_srv_ = this->create_service<${tmpltHelper.slash2Cc(${tmpltHelper.convServiceType(${service.type}, ${rosParam})})}>("${service.name}", std::bind(&${rosParam.className}::handle_${service.name}, this, std::placeholders::_1, std::placeholders::_2));
#end
#end
#if( ${rosParam.actionClients.size()}>0 )
#foreach($action in ${rosParam.actionClients})
  ${action.name}_client_ = rclcpp_action::create_client<${tmpltHelper.capitalize(${action.name})}>(this, "${action.name}");
#end
#end
#if( ${rosParam.actionServers.size()}>0 )
#foreach($action in ${rosParam.actionServers})
  ${action.name}_server_ = rclcpp_action::create_server<${tmpltHelper.capitalize(${action.name})}>(this, "${action.name}", std::bind(&${rosParam.className}::handle_goal_${action.name}, this, std::placeholders::_1, std::placeholders::_2), std::bind(&${rosParam.className}::handle_cancel_${action.name}, this, std::placeholders::_1), std::bind(&${rosParam.className}::handle_accepted_${action.name}, this, std::placeholders::_1));
#end
#end
#if( ${rosParam.timers.size()}>0 )
#foreach($timer in ${rosParam.timers})
  // Timer: ${timer.name}
  // Period: ${timer.rate} sec
  // Callback: ${timer.callBack}()
  // Description: ${timer.description}
  ${timer.name}_ = this->create_wall_timer(std::chrono::milliseconds(${tmpltHelper.toMilliSec(${timer.rate})}), std::bind(&${rosParam.className}::${timer.callBack}, this));
  ${timer.name}_->cancel();
#end
#end
  return CallbackReturn::SUCCESS;
}

#if( ${rosParam.isCallbackDocExist(1)} )
/*!
 * ${rosParam.getDocActionOverView(1)}
 */
#end
CallbackReturn ${rosParam.className}::on_activate(const rclcpp_lifecycle::State &)
{
  RCLCPP_INFO(this->get_logger(), "[on_activate] called.");
  // TODO: Start processing required while the node is active.
#if( ${rosParam.topicPublishes.size()}>0 )
#foreach($topic in ${rosParam.topicPublishes})
  if (${topic.varCallbackName}_) { ${topic.varCallbackName}_->on_activate(); }
#end
#end
#if( ${rosParam.timers.size()}>0 )
#foreach($timer in ${rosParam.timers})
  if (${timer.name}_) { ${timer.name}_->reset(); }
#end
#end
  return CallbackReturn::SUCCESS;
}

#if( ${rosParam.isCallbackDocExist(2)} )
/*!
 * ${rosParam.getDocActionOverView(2)}
 */
#end
CallbackReturn ${rosParam.className}::on_deactivate(const rclcpp_lifecycle::State &)
{
  RCLCPP_INFO(this->get_logger(), "[on_deactivate] called.");
  // TODO: Stop processing before returning to the inactive state.
#if( ${rosParam.topicPublishes.size()}>0 )
#foreach($topic in ${rosParam.topicPublishes})
  if (${topic.varCallbackName}_) { ${topic.varCallbackName}_->on_deactivate(); }
#end
#end
#if( ${rosParam.timers.size()}>0 )
#foreach($timer in ${rosParam.timers})
  if (${timer.name}_) { ${timer.name}_->cancel(); }
#end
#end
  return CallbackReturn::SUCCESS;
}

